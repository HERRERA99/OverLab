<Window x:Class="OverLab.Wpf.Views.Overlays.OverlayInputsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#80000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="500"
        Height="100"
        IsHitTestVisible="False">

    <Canvas x:Name="GraphCanvas">
        <!-- Curvas -->
        <Path x:Name="ThrottlePath" Stroke="Lime" StrokeThickness="2" StrokeLineJoin="Round"/>
        <Path x:Name="BrakePath" Stroke="Red" StrokeThickness="2" StrokeLineJoin="Round"/>
        <Path x:Name="ClutchPath" Stroke="DodgerBlue" StrokeThickness="2" StrokeLineJoin="Round"/>
    </Canvas>
</Window>